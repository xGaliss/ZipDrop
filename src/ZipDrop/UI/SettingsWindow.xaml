<Window x:Class="ZipDrop.UI.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:zd="clr-namespace:ZipDrop"
        Title="{x:Static zd:Strings.SettingsWindowTitle}"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,20">
        <TextBlock Text="{x:Static zd:Strings.SettingsHeader}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,14" />

        <!-- Shortcut -->
        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static zd:Strings.GlobalShortcut}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static zd:Strings.GlobalShortcutHint}" />
                    <TextBlock x:Name="ShortcutError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="ShortcutButton" Grid.Column="1" Style="{StaticResource ButtonBase}" MinWidth="120" Padding="12,6"
                        Background="{DynamicResource HoverBrush}" Click="ShortcutButton_Click"
                        PreviewKeyDown="ShortcutButton_PreviewKeyDown" LostKeyboardFocus="ShortcutButton_LostFocus"
                        ToolTip="{x:Static zd:Strings.ShortcutButtonTip}" AutomationProperties.AutomationId="Shortcut">
                    <TextBlock x:Name="ShortcutText" FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="Ctrl+Shift+Z" />
                </Button>
            </Grid>
        </Border>

        <!-- Shake -->
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="{x:Static zd:Strings.ShakeToOpen}" />
                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static zd:Strings.ShakeHint}" />
                    </StackPanel>
                    <CheckBox x:Name="ShakeEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Margin="12,0,0,0" Checked="OnChanged" Unchecked="OnChanged" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static zd:Strings.ShakeSensitivity}" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="2"
                            IsEnabled="{Binding IsChecked, ElementName=ShakeEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SensLow" Style="{StaticResource SegmentButton}" Content="{x:Static zd:Strings.Low}" GroupName="Sens" Checked="OnChanged" />
                            <RadioButton x:Name="SensMedium" Style="{StaticResource SegmentButton}" Content="{x:Static zd:Strings.Medium}" GroupName="Sens" Checked="OnChanged" />
                            <RadioButton x:Name="SensHigh" Style="{StaticResource SegmentButton}" Content="{x:Static zd:Strings.High}" GroupName="Sens" Checked="OnChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="ShakeError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Clear after zip -->
        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static zd:Strings.ClearAfterZip}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static zd:Strings.ClearAfterZipHint}" />
                </StackPanel>
                <CheckBox x:Name="ClearAfterZip" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          Margin="12,0,0,0" Checked="OnChanged" Unchecked="OnChanged" />
            </Grid>
        </Border>

        <!-- Startup -->
        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="{x:Static zd:Strings.LaunchAtStartup}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static zd:Strings.LaunchAtStartupHint}" />
                </StackPanel>
                <CheckBox x:Name="LaunchAtStartup" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          Margin="12,0,0,0" Checked="OnChanged" Unchecked="OnChanged" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="2,10,0,0"
                   Text="{x:Static zd:Strings.PrivacyNote}" />

        <!-- About -->
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,10" />
        <DockPanel Margin="2,0,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/xGaliss/ZipDrop/releases" RequestNavigate="Link_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}" TextDecorations="{x:Null}"><Run Text="{x:Static zd:Strings.Releases}" /></Hyperlink>
                </TextBlock>
                <TextBlock Text="·" Margin="8,0" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" />
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/xGaliss/ZipDrop" RequestNavigate="Link_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}" TextDecorations="{x:Null}">GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>
            <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" Text="ZipDrop" />
        </DockPanel>
    </StackPanel>
</Window>
