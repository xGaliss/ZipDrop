<Window x:Class="ZipDrop.UI.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZipDrop Settings"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TertiaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,20">
        <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,0,0,14" />

        <!-- Shortcut -->
        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Global shortcut" />
                    <TextBlock Style="{StaticResource Hint}" Text="Shows or hides the basket from anywhere." />
                    <TextBlock x:Name="ShortcutError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="ShortcutButton" Grid.Column="1" Style="{StaticResource ButtonBase}" MinWidth="120" Padding="12,6"
                        Background="{DynamicResource HoverBrush}" Click="ShortcutButton_Click"
                        PreviewKeyDown="ShortcutButton_PreviewKeyDown" LostKeyboardFocus="ShortcutButton_LostFocus"
                        ToolTip="Click, then press the new key combination (Esc cancels)">
                    <TextBlock x:Name="ShortcutText" FontFamily="Cascadia Mono, Consolas" FontSize="12" Text="Ctrl+Shift+Z" />
                </Button>
            </Grid>
        </Border>

        <!-- Shake -->
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="Shake to open" />
                        <TextBlock Style="{StaticResource Hint}" Text="While dragging files from Explorer or the desktop, shake the mouse left-right." />
                    </StackPanel>
                    <CheckBox x:Name="ShakeEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              Margin="12,0,0,0" Checked="OnChanged" Unchecked="OnChanged" />
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Label}" Text="Shake sensitivity" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="2"
                            IsEnabled="{Binding IsChecked, ElementName=ShakeEnabled}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SensLow" Style="{StaticResource SegmentButton}" Content="Low" GroupName="Sens" Checked="OnChanged" />
                            <RadioButton x:Name="SensMedium" Style="{StaticResource SegmentButton}" Content="Medium" GroupName="Sens" Checked="OnChanged" />
                            <RadioButton x:Name="SensHigh" Style="{StaticResource SegmentButton}" Content="High" GroupName="Sens" Checked="OnChanged" />
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock x:Name="ShakeError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Clear after zip -->
        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Clear basket after creating ZIP" />
                    <TextBlock Style="{StaticResource Hint}" Text="Kept if some files could not be read." />
                </StackPanel>
                <CheckBox x:Name="ClearAfterZip" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          Margin="12,0,0,0" Checked="OnChanged" Unchecked="OnChanged" />
            </Grid>
        </Border>

        <!-- Startup -->
        <Border Style="{StaticResource Row}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Launch at startup" />
                    <TextBlock Style="{StaticResource Hint}" Text="Starts quietly in the system tray." />
                </StackPanel>
                <CheckBox x:Name="LaunchAtStartup" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                          Margin="12,0,0,0" Checked="OnChanged" Unchecked="OnChanged" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="2,10,0,0"
                   Text="ZipDrop works entirely on this PC. No accounts, no cloud, no telemetry." />

        <!-- About -->
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14,0,10" />
        <DockPanel Margin="2,0,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/xGaliss/ZipDrop/releases" RequestNavigate="Link_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}" TextDecorations="{x:Null}">Releases</Hyperlink>
                </TextBlock>
                <TextBlock Text="·" Margin="8,0" FontSize="12" Foreground="{DynamicResource TertiaryTextBrush}" />
                <TextBlock FontSize="12">
                    <Hyperlink NavigateUri="https://github.com/xGaliss/ZipDrop" RequestNavigate="Link_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}" TextDecorations="{x:Null}">GitHub</Hyperlink>
                </TextBlock>
            </StackPanel>
            <TextBlock x:Name="VersionText" FontSize="12" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}" Text="ZipDrop" />
        </DockPanel>
    </StackPanel>
</Window>
