<Window x:Class="ZipDrop.UI.OverlayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ZipDrop.UI"
        xmlns:zd="clr-namespace:ZipDrop"
        xmlns:core="clr-namespace:ZipDrop.Core.Baskets;assembly=ZipDrop.Core"
        Title="ZipDrop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        AllowDrop="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}">

    <!-- AutomationIds are stable (English) for scripts/tests; AutomationProperties.Name follows the UI language. -->

    <Window.InputBindings>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}" />
        <KeyBinding Key="Insert" Modifiers="Shift" Command="{Binding PasteCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:SizeConverter x:Key="SizeText" />
        <ui:ItemIconConverter x:Key="ItemIcon" />

        <!-- Fanned icon in the preview stack -->
        <Style x:Key="StackIcon" TargetType="Image">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.9" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35" Color="{DynamicResource ShadowColor}" />
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type core:BasketItem}">
            <Border x:Name="Row" Height="32" CornerRadius="6" Background="Transparent" Padding="4,0,0,0" ToolTip="{Binding FullPath}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Icon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Converter={StaticResource ItemIcon}, ConverterParameter=Large}" />
                    <TextBlock x:Name="Warn" Style="{StaticResource IconText}" FontSize="13" Visibility="Collapsed"
                               Foreground="{DynamicResource WarningBrush}" Text="{StaticResource Glyph.Warning}" />
                    <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding DisplayName}" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,8,0" />
                    <TextBlock x:Name="Size" Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TertiaryTextBrush}"
                               Text="{Binding SizeBytes, Converter={StaticResource SizeText}}" />
                    <Button x:Name="RemoveBtn" Grid.Column="3" Style="{StaticResource IconButton}" Width="22" Height="22"
                            Content="{StaticResource Glyph.Close}" FontSize="8" Visibility="Hidden"
                            ToolTip="{x:Static zd:Strings.RemoveFromBasket}"
                            AutomationProperties.AutomationId="Remove" AutomationProperties.Name="{x:Static zd:Strings.RemoveFromBasket}"
                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Warn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                    <Setter TargetName="Size" Property="Text" Value="{x:Static zd:Strings.Missing}" />
                    <Setter TargetName="Size" Property="Foreground" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Storyboard x:Key="DropIn">
            <DoubleAnimation Storyboard.TargetName="DropLayer" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
        </Storyboard>
        <Storyboard x:Key="DropBob">
            <DoubleAnimation Storyboard.TargetName="DropGlyphShift" Storyboard.TargetProperty="Y" From="-4" To="4"
                             Duration="0:0:0.55" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="DropOut">
            <DoubleAnimation Storyboard.TargetName="DropLayer" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="Root" Margin="18" Width="264" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>

        <!-- Shadow lives on a separate element so text keeps ClearType. -->
        <Border CornerRadius="16" Background="{DynamicResource CardBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.34" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="16" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" Padding="14,8,10,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: logo + name, drag handle -->
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/ZipDrop.ico" Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                        <TextBlock Text="ZipDrop" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Settings}" FontSize="11"
                                ToolTip="{x:Static zd:Strings.SettingsTip}" AutomationProperties.AutomationId="Settings"
                                AutomationProperties.Name="{x:Static zd:Strings.SettingsTip}" Command="{Binding SettingsCommand}" Cursor="Hand" />
                        <Button Style="{StaticResource IconButton}" Content="{StaticResource Glyph.Close}"
                                ToolTip="{x:Static zd:Strings.HideTip}" AutomationProperties.AutomationId="Hide"
                                AutomationProperties.Name="{x:Static zd:Strings.HideTip}" Command="{Binding CloseCommand}" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- Body -->
                <Grid Grid.Row="1" Margin="0,8,4,0" MinHeight="132">

                    <!-- Empty: dashed drop zone -->
                    <Grid Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                        <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource SecondaryTextBrush}" Opacity="0.45"
                                   StrokeThickness="1.4" StrokeDashArray="4 3" Fill="{DynamicResource SurfaceBrush}" />
                        <StackPanel VerticalAlignment="Center" Margin="8,14">
                            <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Style="{StaticResource IconText}" FontSize="17" Text="{StaticResource Glyph.Download}"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{x:Static zd:Strings.DropFilesHere}" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Static zd:Strings.DropOrPaste}" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource TertiaryTextBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- Summary + list -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}">
                        <!-- Fanned stack of the latest items' icons -->
                        <Grid Height="54" Width="96" HorizontalAlignment="Center">
                            <Image Style="{StaticResource StackIcon}" Source="{Binding PreviewIcon1}" Margin="0,4,30,0">
                                <Image.RenderTransform><RotateTransform Angle="-14" /></Image.RenderTransform>
                            </Image>
                            <Image Style="{StaticResource StackIcon}" Source="{Binding PreviewIcon2}" Margin="30,4,0,0">
                                <Image.RenderTransform><RotateTransform Angle="14" /></Image.RenderTransform>
                            </Image>
                            <Image Style="{StaticResource StackIcon}" Source="{Binding PreviewIcon3}" Margin="0,0,0,4" />
                        </Grid>

                        <TextBlock x:Name="CountText" Text="{Binding CountText}" HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="24"
                                   FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="CountScale" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Style="{StaticResource ButtonBase}" Padding="8,3" Margin="0,0,4,0" Command="{Binding ToggleListCommand}"
                                    Background="{DynamicResource WarningSoftBrush}" ToolTip="{x:Static zd:Strings.ShowMissingTip}"
                                    AutomationProperties.AutomationId="ShowMissing" AutomationProperties.Name="{x:Static zd:Strings.ShowMissingTip}"
                                    Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource Glyph.Warning}" FontSize="11"
                                               Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="{Binding MissingText}" Margin="5,0,0,0" FontSize="11.5"
                                               Foreground="{DynamicResource WarningBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SubtleButton}" Command="{Binding ToggleListCommand}" Padding="8,3"
                                    AutomationProperties.AutomationId="ShowItems" AutomationProperties.Name="{x:Static zd:Strings.Items}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{x:Static zd:Strings.Items}" FontSize="11.5" />
                                    <TextBlock x:Name="Chevron" Style="{StaticResource IconText}" FontSize="9" Margin="5,1,0,0"
                                               Text="{StaticResource Glyph.ChevronDown}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4" />
                            <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Basket.Items}" ItemTemplate="{StaticResource ItemTemplate}" />
                            </ScrollViewer>
                            <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Margin="-4,4,0,0"
                                    Content="{x:Static zd:Strings.RemoveMissingItems}" Foreground="{DynamicResource WarningBrush}"
                                    AutomationProperties.AutomationId="RemoveMissing"
                                    Command="{Binding RemoveMissingCommand}"
                                    Visibility="{Binding HasMissing, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Zipping -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsZipping, Converter={StaticResource BoolToVis}}">
                        <Border Width="42" Height="42" CornerRadius="21" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Style="{StaticResource IconText}" FontSize="17" Text="{StaticResource Glyph.Package}"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                        <TextBlock Text="{x:Static zd:Strings.CreatingZip}" HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" />
                        <ProgressBar Margin="8,12,8,0" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button Style="{StaticResource SubtleButton}" Content="{x:Static zd:Strings.Cancel}" HorizontalAlignment="Center"
                                Margin="0,6,0,0" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="Cancel" />
                    </StackPanel>

                    <!-- Done: the ZIP itself, ready to drag anywhere -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource SuccessBrush}">
                                <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="{StaticResource Glyph.Check}" Foreground="White" />
                            </Border>
                            <TextBlock Text="{x:Static zd:Strings.ZipCreated}" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Draggable file chip -->
                        <Border x:Name="ZipChip" Margin="0,12,0,0" Padding="10,8" CornerRadius="10" Cursor="Hand"
                                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                ToolTip="{x:Static zd:Strings.DragToShareTip}"
                                AutomationProperties.AutomationId="ZipFile" AutomationProperties.Name="{Binding ResultName}"
                                PreviewMouseLeftButtonDown="ZipChip_MouseDown" PreviewMouseMove="ZipChip_MouseMove">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ResultIcon}" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ResultName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ResultSizeText}" FontSize="11.5" Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <!-- Grip dots: "you can drag this" -->
                                <TextBlock Grid.Column="2" Style="{StaticResource IconText}" Text="&#xE76F;" FontSize="14"
                                           Foreground="{DynamicResource TertiaryTextBrush}" />
                            </Grid>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{x:Static zd:Strings.DragToShare}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   FontSize="11" Foreground="{DynamicResource TertiaryTextBrush}" />
                        <TextBlock Text="{Binding ResultNotes}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}"
                                   Visibility="{Binding HasResultNotes, Converter={StaticResource BoolToVis}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CopyZipCommand}" Padding="10,7"
                                    ToolTip="{x:Static zd:Strings.CopyTip}"
                                    AutomationProperties.AutomationId="CopyZip" AutomationProperties.Name="{x:Static zd:Strings.Copy}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                                    <TextBlock Text="{x:Static zd:Strings.Copy}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ButtonBase}" Background="{DynamicResource HoverBrush}"
                                    Command="{Binding OpenFolderCommand}" Padding="10,7" FontSize="13"
                                    AutomationProperties.AutomationId="OpenFolder" AutomationProperties.Name="{x:Static zd:Strings.OpenFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource Glyph.FolderOpen}" />
                                    <TextBlock Text="{x:Static zd:Strings.OpenFolder}" Margin="7,0,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Button Style="{StaticResource SubtleButton}" Content="{x:Static zd:Strings.Done}" HorizontalAlignment="Center"
                                Margin="0,6,0,0" Command="{Binding DismissCommand}" AutomationProperties.AutomationId="Done" />
                    </StackPanel>

                    <!-- Error -->
                    <StackPanel VerticalAlignment="Center" Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource IconText}" FontSize="22" Text="{StaticResource Glyph.Warning}"
                                   Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="{x:Static zd:Strings.CouldNotCreate}" HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ErrorText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0"
                                   FontSize="11.5" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="{Binding ErrorText}" />
                        <Button Style="{StaticResource SubtleButton}" Content="{x:Static zd:Strings.BackToBasket}" HorizontalAlignment="Center"
                                Margin="0,8,0,0" Command="{Binding DismissCommand}" AutomationProperties.AutomationId="BackToBasket" />
                    </StackPanel>
                </Grid>

                <!-- Toast -->
                <Border Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,4,0" Padding="10,3" CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        Visibility="{Binding HasToast, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Toast}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
                </Border>

                <!-- Footer -->
                <DockPanel Grid.Row="3" Margin="0,12,4,0" LastChildFill="True"
                           Visibility="{Binding ShowSummary, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Left" Style="{StaticResource SubtleButton}" Content="{Binding ClearText}"
                            Command="{Binding ClearCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="Clear"
                            ToolTip="{x:Static zd:Strings.ClearTip}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateZipCommand}"
                            AutomationProperties.AutomationId="CreateZip" AutomationProperties.Name="{x:Static zd:Strings.CreateZip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="{StaticResource Glyph.Package}" FontSize="13" />
                            <TextBlock Text="{x:Static zd:Strings.CreateZip}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Drag-over layer -->
        <Border x:Name="DropLayer" CornerRadius="16" Background="{DynamicResource CardBrush}" Opacity="0" IsHitTestVisible="False">
            <Grid Margin="8">
                <Rectangle RadiusX="12" RadiusY="12" Fill="{DynamicResource AccentSoftBrush}" Stroke="{DynamicResource AccentBrush}"
                           StrokeThickness="2" StrokeDashArray="5 3" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource AccentBrush}">
                        <TextBlock Style="{StaticResource IconText}" FontSize="22" Text="{StaticResource Glyph.Download}"
                                   Foreground="{DynamicResource AccentTextBrush}">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="DropGlyphShift" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{x:Static zd:Strings.DropToAdd}" HorizontalAlignment="Center" Margin="0,12,0,0" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock x:Name="DropHint" Text="{x:Static zd:Strings.AddToZip}" HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
